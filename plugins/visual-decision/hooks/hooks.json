{
  "description": "Sends questions Claude was about to ask in the terminal (AskUserQuestion) to the visual-decision web page, and at session start points Claude to earlier decisions in .hus-visual-decision/decisions/ when there are any.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/ask-hook.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-hook.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
