{
  "description": "Redirects decisions to a web page (only where askHook is on in .hus-visual-decision/config.json) and writes finished decisions to documents (only when an answer file exists). Does nothing otherwise.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/ask-hook.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record-hook.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
